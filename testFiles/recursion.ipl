int iterations = 10;

fn factorialLoop(int x) -> int
{
    int i = 1;
    int accum = 1;

    while ( i <= x )
    {
        accum *= i;
        i += 1;
    }

    return accum;
}

fn factorialRec(int x) -> int
{
    if ( x <= 0 )
    {
        return 1;
    }
    if ( x == 2 )
    {
        return 2;
    }

    return x * factorialRec(x - 1);
}

int i = 0;

print("Calculating factorials with a while loop:\n");
while ( i <= iterations )
{
    print( string(i) + "! = " + string( factorialLoop(i) ) + "\n" );

    i += 1;
}

i = 0;

print("\nCalculating factorials with recursion:\n");
while ( i <= iterations )
{
    print( string(i) + "! = " + string( factorialRec(i) ) + "\n" );

    i += 1;
}
