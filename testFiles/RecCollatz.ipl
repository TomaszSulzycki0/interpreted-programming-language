fn RecCollatz(int x, int num_steps) -> int
{    
    if ( x == 1)
    {
        return num_steps;
    }

    if ( x % 2 == 0)
    {
        return RecCollatz( x / 2 , num_steps + 1);
    }
    else
    {
        return RecCollatz(3 * x + 1, num_steps + 1);
    }
}

int num_samples = 100;
int i = 1;

while( i < num_samples )
{
    int result = RecCollatz(i, 0);
    print( "Number of steps to reach 1 from " + string(i) + " : " + string(result) + "\n" );
    i += 1;
}